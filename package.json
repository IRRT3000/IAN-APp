{
  "name": "mi-fitness-app",
  "version": "1.1.1",
  "main": "index.js",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.19",
    "expo-blur": "~58.0.5",
    "expo-clipboard": "~58.0.4",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-worklets": "0.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "test": "jest --ci",
    "test:watch": "jest --watchAll",
    "bundle:check": "expo export --platform android --output-dir .flow-export",
    "gate": "npm run lint && npm test && npm run bundle:check",
    "flow": "node workflow/flow.mjs",
    "flow:doctor": "node workflow/flow.mjs doctor",
    "flow:setup": "node workflow/flow.mjs setup",
    "flow:selftest": "node workflow/selftest.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.agents/",
      "/workflow/",
      "/.flow-export/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.agents/",
      "<rootDir>/.flow-export/",
      "<rootDir>/workflow/"
    ]
  },
  "private": true
}
