{
  "name": "mi-fitness-app",
  "version": "2.2.0",
  "main": "index.js",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-blur": "~58.0.6",
    "expo-clipboard": "~58.0.4",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.8",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "eslint": "^9",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30",
    "jest-expo": "~58.0.15",
    "test-renderer": "1.3.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "lint": "eslint .",
    "test": "node scripts/test-gate.js",
    "test:watch": "jest --watchAll",
    "bundle:check": "node scripts/bundle-check.js",
    "gate": "npm run lint && npm test && npm run bundle:check"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.agents/",
      "<rootDir>/.bundle-check/",
      "<rootDir>/.claude/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.agents/",
      "<rootDir>/.bundle-check/",
      "<rootDir>/.claude/"
    ],
    "resolver": "react-native-reanimated/jest/resolver"
  },
  "private": true
}
