{
  "expo": {
    "name": "mi-fitness-app",
    "slug": "mi-fitness-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ian.mifitnessapp",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite acceder a tus fotos para analizar comidas y registrar tu cambio físico.",
          "cameraPermission": "Permite usar la cámara para capturar fotos de tus comidas y registrar tu cambio físico."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7cf7af60-cd63-4675-936c-e9cd1d87beab"
      }
    },
    "owner": "elashcode"
  }
}
